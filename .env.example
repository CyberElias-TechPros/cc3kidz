# Copy to .env.local and fill
DATABASE_URL="postgresql://user:pass@host:5432/cc3?sslmode=require"
# Neon / Vercel Postgres connection string

# Session — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-this-to-64-char-random-secret-please-generate-new-one!!!"

# Email (optional — if empty, emails are logged not sent)
RESEND_API_KEY=""
EMAIL_FROM="CC3 <no-reply@cecentralchurch3.org>"

# Uploads
UPLOAD_MAX_MB=8
