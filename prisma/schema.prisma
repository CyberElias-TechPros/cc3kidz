generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  leader
  admin
  superadmin
}

enum GivingStatus {
  pending
  verified
  rejected
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(member)
  cellId       String?
  department   String?
  avatar       String?
  emailVerified Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLogin    DateTime?

  foundationProgress FoundationProgress[]
  givingTransactions GivingTransaction[]
  auditLogs          AuditLog[]
}

model Visit {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  date      String
  visitors  Int      @default(1)
  firstTime String?
  children  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

model Prayer {
  id           String   @id @default(cuid())
  name         String?
  contact      String?
  category     String   @default("Personal")
  body         String
  confidential Boolean  @default(true)
  followUp     Boolean  @default(false)
  status       String   @default("open") // open, assigned, closed
  createdAt    DateTime @default(now())
}

model Testimony {
  id        String   @id @default(cuid())
  name      String
  title     String
  category  String
  body      String   @db.Text
  consent   Boolean
  status    String   @default("pending") // pending, approved, published, rejected
  createdAt DateTime @default(now())
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  memberStatus String   @default("Member")
  department   String
  skills       String[] @default([])
  availability String?
  note         String?
  status       String   @default("pending") // pending, contacted, approved, active
  createdAt    DateTime @default(now())
}

model EventReg {
  id        String   @id @default(cuid())
  eventSlug String
  name      String
  phone     String
  email     String?
  attendees Int      @default(1)
  member    String   @default("visitor")
  ticket    String   @unique
  createdAt DateTime @default(now())
}

model ContactMsg {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  category  String   @default("General enquiries")
  message   String   @db.Text
  method    String?  @default("Phone")
  createdAt DateTime @default(now())
}

model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model FoundationReg {
  id           String   @id @default(cuid())
  name         String
  phone        String
  pref         String   @default("Weekday Evening")
  availability String?
  createdAt    DateTime @default(now())
}

model AttendanceReport {
  id        String   @id @default(cuid())
  cellId    String
  churchId  String?
  date      String
  present   Int
  visitors  Int      @default(0)
  souls     Int      @default(0)
  outreach  String?
  topic     String?
  note      String?  @db.Text
  leaderId  String?
  createdAt DateTime @default(now())
  @@index([cellId])
  @@index([churchId])
  @@index([date])
}

model DeptAttendance {
  id           String   @id @default(cuid())
  departmentId String
  date         String
  present      Int
  late         Int      @default(0)
  absent       Int      @default(0)
  activity     String?
  note         String?
  leaderId     String?
  createdAt    DateTime @default(now())
  @@index([departmentId])
  @@index([date])
}

model FoundationProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleSlug String
  completed  Boolean  @default(false)
  score      Int?
  updatedAt  DateTime @updatedAt
  @@unique([userId, moduleSlug])
}

model GivingFund {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  purpose     String?  @db.Text
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  bankAccounts BankAccount[]
  transactions GivingTransaction[]
}

model BankAccount {
  id          String   @id @default(cuid())
  fundId      String
  fund        GivingFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  bankName    String
  accountName String
  accountNo   String
  sortCode    String? // for display
  currency    String   @default("NGN")
  instructions String? @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model GivingTransaction {
  id          String       @id @default(cuid())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  fundId      String
  fund        GivingFund   @relation(fields: [fundId], references: [id])
  bankAccountId String?
  amount      Decimal      @db.Decimal(12,2)
  currency    String       @default("NGN")
  reference   String?      // bank ref / transfer ref
  popUrl      String?      // path to POP image/pdf in blob storage
  popMime     String?
  note        String?      @db.Text
  status      GivingStatus @default(pending)
  verifiedBy  String?
  verifiedAt  DateTime?
  receiptNo   String?      @unique
  createdAt   DateTime     @default(now())
  @@index([fundId])
  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([action])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String? // null = broadcast
  title     String
  body      String   @db.Text
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
}
